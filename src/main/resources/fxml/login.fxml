<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.satdb.ui.controller.LoginController"
      spacing="12" alignment="CENTER" prefWidth="980" prefHeight="640"
      style="-fx-background-color: #10151f;">
    <padding><Insets top="24" right="48" bottom="24" left="48"/></padding>

    <Label text="🛰 Satellite Database"
           style="-fx-text-fill: #e6edf3; -fx-font-size: 28px; -fx-font-weight: bold;"/>
    <Label text="Учёт частотных присвоений радиоэлектронных средств"
           style="-fx-text-fill: #8b949e; -fx-font-size: 13px;"/>

    <VBox spacing="10" maxWidth="360" prefWidth="360"
          style="-fx-background-color: #1c2230; -fx-background-radius: 10; -fx-padding: 24;">
        <Label text="Имя пользователя" style="-fx-text-fill: #c9d1d9;"/>
        <TextField fx:id="usernameField" promptText="admin | supervisor | operator"/>
        <Label text="Пароль" style="-fx-text-fill: #c9d1d9;"/>
        <PasswordField fx:id="passwordField" promptText="••••••••"/>
        <Button fx:id="loginButton" text="Войти" onAction="#onLogin"
                maxWidth="Infinity"
                style="-fx-background-color: #2f6feb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;"/>
        <Label fx:id="errorLabel" wrapText="true" visible="false"
               style="-fx-text-fill: #f85149; -fx-font-size: 12px;"/>
    </VBox>

    <HBox spacing="8">
        <Label text="Тестовые аккаунты (seed V6): admin/Admin123 · supervisor/Supervisor123 · operator/Operator123"
               style="-fx-text-fill: #4d5566; -fx-font-size: 11px;"/>
    </HBox>
</VBox>
