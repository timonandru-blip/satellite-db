<?xml version="1.0" encoding="UTF-8"?>

<!--
  Экран «Список радиоизлучений с фильтрацией по частоте» (ТЗ, 10-javafx-ui/SKILL.md).

  Структура:
    top    — панель поиска: TextField мин/макс частоты, ComboBox модуляции, кнопка «Фильтр»;
    center — TableView строк RadioEmissionViewModel (наблюдаемые свойства из
             com.satdb.ui.viewmodel), колонки биндятся по конвенции JavaFX
             (property <имя>Property() / getter get<Имя>());
    bottom — Pagination + статусная строка счётчика.

  Контроллер инъецируется Spring-бинами через FxSpringControllerFactory
  (конструкторная инъекция). Секция вставляется в центр BorderPane оболочки
  MainViewController через ShellService.setCenter().

  Стили: базовые классы стилей (.section-toolbar, .filter-field) + inline-стили —
  тёмная тема согласована с main.fxml/login.fxml.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.satdb.ui.controller.EmissionListController"
            fx:id="sectionRoot"
            style="-fx-background-color: #1e2430;">

    <!-- ==================== ПАНЕЛЬ ПОИСКА / ФИЛЬТРОВ ==================== -->
    <top>
        <VBox spacing="6" style="-fx-padding: 10 12 6 12;">
            <HBox spacing="8" alignment="CENTER_LEFT">

                <Label text="Частота от," style="-fx-text-fill: #bdc3c7;"/>
                <TextField fx:id="minFreqField" promptText="МГц, напр. 137"
                           prefWidth="120" maxWidth="160"
                           style="-fx-background-color: #2c3345; -fx-text-fill: #ecf0f1; -fx-prompt-text-fill: #5d6b82;"/>

                <Label text="до," style="-fx-text-fill: #bdc3c7;"/>
                <TextField fx:id="maxFreqField" promptText="МГц, напр. 150"
                           prefWidth="120" maxWidth="160"
                           style="-fx-background-color: #2c3345; -fx-text-fill: #ecf0f1; -fx-prompt-text-fill: #5d6b82;"/>

                <Label text="Модуляция:" style="-fx-text-fill: #bdc3c7;"/>
                <ComboBox fx:id="modulationBox" prefWidth="150" promptText="— любая —"/>

                <!-- Основная кнопка экрана: применяет оба фильтра сразу -->
                <Button fx:id="filterButton" text="Фильтр" onAction="#onFilter"
                        defaultButton="true"
                        style="-fx-background-color: #3d6df2; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 16;"/>

                <Button fx:id="resetButton" text="Сбросить" onAction="#onReset"
                        style="-fx-background-color: #3a4257; -fx-text-fill: #dfe4ee; -fx-padding: 6 12;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="countLabel" text="—"
                       style="-fx-text-fill: #7f8fa6; -fx-font-size: 12px;"/>
            </HBox>

            <!-- Строка ошибок валидации фильтров (видна только при некорректном вводе) -->
            <Label fx:id="errorLabel" visible="false" managed="false" wrapText="true"
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;"/>
        </VBox>
    </top>

    <!-- ==================== ТАБЛИЦА РЕЗУЛЬТАТОВ ==================== -->
    <center>
        <VBox fx:id="tableBox" spacing="0">
            <TableView fx:id="emissionsTable" VBox.vgrow="ALWAYS"
                       placeholder="Нет данных по заданному фильтру"
                       style="-fx-control-inner-background: #232937; -fx-background-color: transparent;">

                <!-- table-row-factory контроллера навешивает псевдокласс "pending"
                     на строки с открытой PENDING-заявкой (см. ViewModel.isPending) -->
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>

                <columns>
                    <!-- Статус согласования: галочка из BooleanProperty isPending -->
                    <TableColumn fx:id="colPending" text="⏳" prefWidth="42" sortable="false" resizable="false"/>
                    <TableColumn fx:id="colCode" text="Код" prefWidth="130"/>
                    <TableColumn fx:id="colName" text="Наименование" prefWidth="230"/>
                    <TableColumn fx:id="colSystem" text="Система" prefWidth="110"/>
                    <TableColumn fx:id="colFreq" text="Частота, МГц" prefWidth="120"/>
                    <TableColumn fx:id="colBw" text="Полоса, кГц" prefWidth="100"/>
                    <TableColumn fx:id="colMod" text="Модуляция" prefWidth="110"/>
                    <TableColumn fx:id="colPower" text="Мощн., dBm" prefWidth="90"/>
                    <TableColumn fx:id="colPriority" text="Приоритет" prefWidth="80"/>
                    <TableColumn fx:id="colUpdated" text="Изменено" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- ==================== ПАГИНАЦИЯ ==================== -->
    <bottom>
        <Pagination fx:id="pagination" maxPageIndicatorCount="10"
                    style="-fx-padding: 4 12 8 12;"/>
    </bottom>

</BorderPane>
