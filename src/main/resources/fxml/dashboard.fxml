<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.satdb.ui.controller.DashboardController">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-background-color: #161b27; -fx-padding: 10 16;">
            <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
            <Label text="🛰 Satellite Database"
                   style="-fx-text-fill: #e6edf3; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label fx:id="userBadge" text="—" style="-fx-text-fill: #7d8590;"/>
            <VBox HBox.hgrow="ALWAYS"/>
            <MenuButton fx:id="navMenuButton" text="Экраны"
                        style="-fx-background-color: #21262d; -fx-text-fill: #c9d1d9;"/>
            <Button fx:id="refreshButton" text="⟳ Обновить" onAction="#onRefresh"
                    style="-fx-background-color: #21262d; -fx-text-fill: #c9d1d9;"/>
            <Button fx:id="logoutButton" text="Выйти" onAction="#onLogout"
                    style="-fx-background-color: #da3633; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="emissionsTable" BorderPane.alignment="CENTER">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="16" alignment="CENTER_LEFT"
              style="-fx-background-color: #161b27; -fx-padding: 8 16;">
            <Label fx:id="statusLabel" text="Готово" style="-fx-text-fill: #7d8590;"/>
            <Label fx:id="pendingBadge" text="" style="-fx-text-fill: #d29922;"/>
        </HBox>
    </bottom>
</BorderPane>
